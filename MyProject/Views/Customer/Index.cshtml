@model List<MyProject.Models.Customer>

<h2>Customers</h2>

<table class="table">

    <thead>

        <tr>

            <th>Id</th>

            <th>Name</th>

            <th>Email</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var customer in Model)

        {

            <tr>

                <td>@customer.Id</td>

                <td>@customer.Name</td>

                <td>@customer.Email</td>

            </tr>

        }

    </tbody>

</table
